# Copy to frontend/.env and fill in. NEVER commit the real .env.
# Everything here ends up in the browser bundle: only public values, never the service-role key.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Backend URL for production builds. Leave empty locally (Vite proxies /api to http://localhost:8000).
# VITE_API_BASE_URL=https://your-backend.example.com

# Production: the public site address, used as the redirect for emailed links (password reset, sign-up confirmation).
# It must also be in Supabase -> Authentication -> URL Configuration -> Redirect URLs. Leave unset locally.
# VITE_SITE_URL=https://your-frontend.example.com

# LOCAL DEV ONLY: shows the insecure "Instant Reset" tab (also needs ALLOW_DIRECT_PASSWORD_RESET=true on the backend).
# VITE_ENABLE_INSTANT_RESET=false

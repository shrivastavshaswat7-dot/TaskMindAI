# Copy to backend/.env and fill in. NEVER commit the real .env.
# Server-side secrets only: these must never go into the frontend.

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# Supabase project URL and the SERVICE ROLE key (Dashboard -> Settings -> API). Server only!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Deployed frontend origin(s), comma separated (only needed when deployed; localhost is built in)
# EXTRA_ALLOWED_ORIGINS=https://your-frontend.example.com

# LOCAL DEV ONLY, insecure: lets anyone reset any account's password knowing only the email.
# Leave unset/false everywhere except your own machine. Never enable on a public deployment.
# ALLOW_DIRECT_PASSWORD_RESET=false
